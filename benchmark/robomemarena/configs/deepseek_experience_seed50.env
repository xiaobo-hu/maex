# RoboMemArena Task 1..26 first experience batch. This file must not contain secrets.
# Planner key/address 仍从本地 .env 的 "# deepseek api" 注释配置块读取。
TASK_ID=1
SEED=50
PLANNER=deepseek
MODEL=deepseek-v4-flash-vision-exp

ACTION_CHUNK_SIZE=20
MAX_VLA_CHUNKS_PER_CALL=20
MAX_AGENT_TURNS=80
MAX_STEPS=2500
PLANNER_RETRIES=3

POLICY_GPU=0
OBSERVER_GPU=1
ENV_GPU=2
POLICY_PORT=8000
ENV_PORT=8001
OBSERVER_PORT=8002
OBSERVER_MODEL_PATH=models/Qwen3-VL-32B-Instruct
OBSERVER_SERVED_MODEL_NAME=robo-observer
OBSERVER_GPU_MEMORY_UTILIZATION=0.90

OBSERVER_TIMESTEPS=5
OBSERVER_MIN_NEW_OBSERVATIONS=10
OBSERVER_GRIPPER_THRESHOLD=0.01
SAVE_OBSERVER_WINDOWS=1
VIDEO_FPS=10
TASK_EXECUTION_SKILL=
