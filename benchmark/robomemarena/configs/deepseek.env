# RoboMemArena single-episode DeepSeek evaluation. This file must not contain secrets.
# Planner key/address 仍从本地 .env 的 "# deepseek api" 注释配置块读取。
TASK_ID=1
SEED=100
PLANNER=deepseek
MODEL=deepseek-flash

ACTION_CHUNK_SIZE=20
MAX_VLA_CHUNKS_PER_CALL=20
MAX_AGENT_TURNS=80
MAX_STEPS=2500
PLANNER_RETRIES=3

export CUDA_DEVICE_ORDER=PCI_BUS_ID
POLICY_GPU=0
OBSERVER_GPU=1,3
ENV_GPU=2
POLICY_PORT=8000
ENV_PORT=8001
OBSERVER_PORT=8002
OBSERVER_MODEL_PATH=models/Qwen3.8-27B
OBSERVER_SERVED_MODEL_NAME=Qwen/Qwen3.8-27B
OBSERVER_VLLM_BIN=models/.venv-observer/bin/vllm
OBSERVER_GPU_MEMORY_UTILIZATION=0.90
# 使用 PyTorch sampler，避免 FlashInfer 在启动时借用宿主机的旧 CUDA 编译器。
export VLLM_USE_FLASHINFER_SAMPLER=0
OBSERVER_VLLM_ARGS=(
  --tensor-parallel-size 2
  --max-num-seqs 8
  --reasoning-parser qwen3
  --default-chat-template-kwargs '{"enable_thinking":false}'
  --limit-mm-per-prompt '{"image":12,"video":0}'
)

OBSERVER_TIMESTEPS=5
OBSERVER_MIN_NEW_OBSERVATIONS=10
OBSERVER_GRIPPER_THRESHOLD=0.01
SAVE_OBSERVER_WINDOWS=0
VIDEO_FPS=10
