# VoLo Only-VLA 接入配置；复用已有 RoboMemArena/OpenPI 服务。
# 模型及密钥由 VOLO_ENV_FILE（默认根目录 .env）提供，可用 VLM_* 覆盖。
VOLO_PORT=${VOLO_PORT:-8040}
VOLO_VLA_HOST=${VOLO_VLA_HOST:-127.0.0.1}
VOLO_VLA_PORT=${VOLO_VLA_PORT:-8000}
# 沿用上游 LIBERO 的 40 步间隔；20 Hz 控制下对应 2 秒仿真时间（0.5 Hz）。
VOLO_CHECK_INTERVAL=${VOLO_CHECK_INTERVAL:-40}
VOLO_LOG_DIR=${VOLO_LOG_DIR:-benchmark/robomemarena/logs/volo/proxy}
# 设置为 1 时启用原生 SAM3 + GraspGen 抓取，放置仍由 VLA 完成。
VOLO_GRASP_ENABLED=${VOLO_GRASP_ENABLED:-0}
GRASP_SERVER_HOST=${GRASP_SERVER_HOST:-127.0.0.1}
GRASP_SERVER_PORT=${GRASP_SERVER_PORT:-8043}
