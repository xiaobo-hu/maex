# HiMe 接入试跑配置；密钥只从根目录 .env 或进程环境读取。
POLICY_GPU=${POLICY_GPU:-0}
ENV_GPU=${ENV_GPU:-0}
OBSERVER_GPU=${OBSERVER_GPU:-1}
POLICY_PORT=${POLICY_PORT:-8020}
ENV_PORT=${ENV_PORT:-8021}
OBSERVER_PORT=${OBSERVER_PORT:-8022}
OBSERVER_MODEL_PATH=models/Qwen3-VL-32B-Instruct
OBSERVER_SERVED_MODEL_NAME=robo-observer
OBSERVER_GPU_MEMORY_UTILIZATION=0.80
# 空字符串选择 EMBEDDING_* 配置的 API。默认本地模型仅用于接入试跑。
HIME_LOCAL_EMBEDDING_MODEL=${HIME_LOCAL_EMBEDDING_MODEL-models/all-MiniLM-L6-v2}
HIME_REUSE_SERVICES=${HIME_REUSE_SERVICES:-0}
